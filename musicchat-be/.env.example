# Copy these into your hosting provider's Environment Variables (Render, Railway...)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/musicChatDatabase?retryWrites=true&w=majority
JWT_SECRET=<long-random-string>
# Comma-separated list of frontend URLs allowed to call the API
CLIENT_URL=https://your-frontend.vercel.app,http://localhost:3000
